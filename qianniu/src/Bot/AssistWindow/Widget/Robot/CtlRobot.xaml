<UserControl
	x:Class="Bot.AssistWindow.Widget.Robot.CtlRobot" 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:Bot.AssistWindow.Widget.Robot"
    xmlns:ticket="clr-namespace:Bot.AssistWindow.Widget.Ticket"
	MinWidth="270"
	Background="{StaticResource uiSurfaceBrush}"
	FontFamily="{StaticResource uiFontFamily}">
    <UserControl.Resources>
        <Style x:Key="AutoReplySwitchStyle" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#EEF5FF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Border
                            x:Name="SwitchRoot"
                            Background="Transparent"
                            CornerRadius="12"
                            Padding="4 3">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter
                                    VerticalAlignment="Center"
                                    Margin="0 0 6 0"
                                    RecognizesAccessKey="True" />
                                <TextBlock
                                    x:Name="StatusText"
                                    Text="关闭"
                                    Foreground="#C8DAFF"
                                    FontWeight="Normal"
                                    VerticalAlignment="Center"
                                    Margin="0 0 7 0" />
                                <Grid Width="26" Height="14" VerticalAlignment="Center">
                                    <Border
                                        x:Name="SwitchTrack"
                                        Background="#55FFFFFF"
                                        CornerRadius="7" />
                                    <Ellipse
                                        x:Name="SwitchThumb"
                                        Width="10"
                                        Height="10"
                                        Margin="2 0 0 0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Fill="#EAF1FF" />
                                </Grid>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SwitchRoot" Property="Background" Value="#18FFFFFF" />
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#77FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="StatusText" Property="Text" Value="开启" />
                                <Setter TargetName="StatusText" Property="Foreground" Value="#FFFFFFFF" />
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#FFFFFFFF" />
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="SwitchThumb" Property="Margin" Value="0 0 2 0" />
                                <Setter TargetName="SwitchThumb" Property="Fill" Value="{StaticResource uiAccentBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="SwitchRoot" Property="Opacity" Value="0.55" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>
    <Grid Margin="0" Background="{StaticResource uiSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>       

        <Grid Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"></RowDefinition>
            </Grid.RowDefinitions>
            <StackPanel x:Name="panelGoods">
                <ProgressBar x:Name="pgDownGoods"
					    Height="3"
					    Margin="8 6"
                        Visibility="Collapsed"
					    IsIndeterminate="True" />
            </StackPanel>
        </Grid>

        <Grid Background="{StaticResource uiAccentBrush}" Grid.Row="1" Margin="8 8 8 6">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Margin="10 0 0 0"  Text="正在接待" Foreground="#FFFFFFFF" FontSize="12" VerticalAlignment="Center"></TextBlock>
            <TextBlock Margin="6 0 0 0" x:Name="txtBuyer" Text="..." Grid.Column="1"
                Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="13"
                TextTrimming="CharacterEllipsis"
                VerticalAlignment="Center"></TextBlock>
            <CheckBox
                Name="cboxAuto"
                Grid.Column="2"
                Margin="8 0 8 0"
                ToolTip="自动切换到发送消息的客户，并将答案【直接发送】给顾客"
                Foreground="#FFFFFFFF"
                Style="{StaticResource AutoReplySwitchStyle}"
                VerticalAlignment="Center"
                Click="cboxAuto_Click">自动回复</CheckBox>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8 0 8 6">
            <ToggleButton x:Name="btnChatTab" IsChecked="True" Tag="Chat" Click="tab_Click" ToolTip="聊天记录" Width="40" Height="35" Margin="0 0 6 0">
                <Image Source="/Bot;component/Asset/image/ticket-tabs/chat.png" Width="18" Height="18" Stretch="Uniform" />
            </ToggleButton>
            <ToggleButton x:Name="btnTicketTab" Tag="Ticket" Click="tab_Click" ToolTip="智能工单" Width="40" Height="35" Margin="0 0 6 0">
                <Image Source="/Bot;component/Asset/image/ticket-tabs/ticket.png" Width="18" Height="18" Stretch="Uniform" />
            </ToggleButton>
            <ToggleButton x:Name="btnQaTab" Tag="Qa" Click="tab_Click" ToolTip="智能问答" Width="40" Height="35">
                <Image Source="/Bot;component/Asset/image/ticket-tabs/qa.png" Width="18" Height="18" Stretch="Uniform" />
            </ToggleButton>
        </StackPanel>
        <ScrollViewer x:Name="scvBody" Grid.Row="3" Margin="0" Background="{StaticResource uiSurfaceSoftBrush}">
            <StackPanel x:Name="stkDialog" Margin="8 2 8 8">
                <Grid
                    Name="grdShowConv"
                    Row="1"
                    Background="{StaticResource uiSurfaceSoftBrush}"
                    Visibility="Collapsed">
                    <ProgressBar
				        Height="14"
				        Margin="20"
				        IsIndeterminate="True" />
                </Grid>
                <Grid Name="grdTipNoConv" Background="{StaticResource uiSurfaceSoftBrush}" Height="200" Visibility="Collapsed">
                    <TextBlock  HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="{StaticResource uiMutedTextBrush}" Text="暂无聊天内容" />
                </Grid>
                <!--<Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="24"></RowDefinition>
                        <RowDefinition Height="*" MinHeight="24"></RowDefinition>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#B39DDB" CornerRadius="2" Margin="2"/>
                    <TextBlock Text="Q" VerticalAlignment="Center" HorizontalAlignment="Center" />
                    --><!--<Rectangle Width="20" Height="20" Fill="#B39DDB" RadiusX="2" RadiusY="2"/>--><!--
                    <TextBlock Text="你好" Grid.Column="1" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="#B39DDB" Grid.Row="1"  CornerRadius="2" Margin="2"/>
                    <TextBlock Text="A" Grid.Row="1" VerticalAlignment="Center"  HorizontalAlignment="Center" />
                    <TextBlock Text="您好，欢迎光临本店..."  Grid.Row="1" Grid.Column="1" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>-->
               
                <!-- 聊天气泡 --><!--
                <StackPanel Orientation="Horizontal" Margin="8 8 8 0">
                    <Rectangle Width="24" Height="24" Fill="#B39DDB" RadiusX="12" RadiusY="12"/>
                    <StackPanel Margin="8,0">
                        <TextBlock Text="你好" FontWeight="Bold"/>
                        <TextBlock Text="您好，欢迎光临本店..." TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
                --><!-- 其他消息仿照上面添加 --><!--
                <StackPanel Orientation="Horizontal" Margin="8,8,8,0">
                    <Rectangle Width="24" Height="24" Fill="#B39DDB" RadiusX="12" RadiusY="12"/>
                    <StackPanel Margin="8 8">
                        <TextBlock Text="在吗" FontWeight="Bold"/>
                        <TextBlock Text="在的哦，请问有什么可以帮您的吗？" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
                --><!-- 更多消息... -->
            </StackPanel>
        </ScrollViewer>
        <ticket:CtlTicket x:Name="ctlTicket" Grid.Row="3" Visibility="Collapsed" />
        <Border x:Name="pnlQa"
            Grid.Row="3"
            Visibility="Collapsed"
            Margin="8 0 8 8"
            Background="{StaticResource uiSurfaceBrush}"
            BorderBrush="{StaticResource uiBorderBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource uiRadiusMd}">
            <Grid Margin="10 8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="模型问答"
                    Foreground="{StaticResource uiTextBrush}"
                    FontWeight="SemiBold"
                    FontSize="12" />
                <TextBlock
                    Grid.Row="1"
                    Margin="0 8 0 0"
                    Text="预留流式问答区域"
                    Foreground="{StaticResource uiSubtleTextBrush}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
