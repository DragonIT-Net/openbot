<UserControl
	x:Class="Bot.AssistWindow.Widget.RightPanel" 
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" 
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" 
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:Bot.AssistWindow.Widget"
	Background="{StaticResource uiSurfaceBrush}"
	FontFamily="{StaticResource uiFontFamily}">
	<FrameworkElement.Resources>
		<ResourceDictionary>
			<SolidColorBrush
				Color="#1E6BFF"
				x:Key="rpSkyBlueBrush" />
			<SolidColorBrush
				Color="#FFFFFF"
				x:Key="rpWhiteBrush" />
			<SolidColorBrush
				Color="#1E6BFF"
				x:Key="rpDodgerBlueBrush" />
			<SolidColorBrush
				Color="#E9EDF3"
				x:Key="rpDisabledBackgroundBrush" />
			<SolidColorBrush
				Color="#C8D1DD"
				x:Key="rpDisabledBorderBrush" />
			<SolidColorBrush
				Color="#8793A3"
				x:Key="rpDisabledForegroundBrush" />
			<Style
				TargetType="{x:Type TabItem}"
				x:Key="tabRightPanel">
				<Setter
					Property="Template">
					<Setter.Value>
						<ControlTemplate
							TargetType="{x:Type TabItem}">
							<Grid>
								<Border
									Name="Border"
									Margin="0,0,4,0"
									BorderThickness="1,1,1,1"
									CornerRadius="6,6,0,0"
									Background="{StaticResource uiSurfaceBrush}"
									BorderBrush="{StaticResource rpSkyBlueBrush}">
									<ContentPresenter
										Name="ContentSite"
										VerticalAlignment="Center"
										HorizontalAlignment="Center"
										ContentSource="Header"
										Margin="14,6"
										RecognizesAccessKey="True" />
								</Border>
							</Grid>
							<ControlTemplate.Triggers>
								<Trigger
									Property="TabItem.IsSelected"
									Value="True">
									<Setter
										Property="Panel.ZIndex"
										Value="100" />
									<Setter
										TargetName="Border"
										Property="Background"
										Value="{StaticResource rpDodgerBlueBrush}" />
									<Setter
										Property="Foreground"
										Value="White" />
									<Setter
										TargetName="Border"
										Property="BorderThickness"
										Value="1,1,1,0" />
								</Trigger>
								<Trigger
									Property="IsEnabled"
									Value="False">
									<Setter
										TargetName="Border"
										Property="Background"
										Value="{StaticResource rpDisabledBackgroundBrush}" />
									<Setter
										TargetName="Border"
										Property="BorderBrush"
										Value="{StaticResource rpDisabledBorderBrush}" />
									<Setter
										Property="Foreground"
										Value="{StaticResource rpDisabledForegroundBrush}" />
								</Trigger>
							</ControlTemplate.Triggers>
						</ControlTemplate>
					</Setter.Value>
				</Setter>
			</Style>
		</ResourceDictionary>
	</FrameworkElement.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="38" />
			<RowDefinition
				Height="Auto" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<Rectangle
			Grid.RowSpan="3"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			Fill="{StaticResource uiSurfaceBrush}"
			Stroke="{StaticResource uiBorderBrush}"
			StrokeThickness="1">
			<UIElement.Effect>
				<DropShadowEffect
					BlurRadius="18"
					Color="#8AA0B6"
					Opacity="0.22"
					ShadowDepth="0" />
			</UIElement.Effect>
		</Rectangle>
        <Grid
			Background="{StaticResource uiAccentBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition
					Width="auto" />
                <ColumnDefinition
					Width="auto" />
                <ColumnDefinition
					Width="auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
				Orientation="Horizontal"
				Margin="8 0 0 0">
                <Image
					Source="{StaticResource iconYellow}"
					Width="16"
					Height="16"
					Margin="0 0 8 0"
					VerticalAlignment="Center"
                    />
                <Label
					Name="lblSeller"
					VerticalAlignment="Center"
					Foreground="#FFFFFFFF"
					FontSize="13"
					FontWeight="SemiBold"
					Padding="0" />
            </StackPanel>
            <Button
				Name="btnOption"
				Grid.Column="2"
				Background="#FFFFFFFF"
				BorderBrush="#66FFFFFF"
				Foreground="{StaticResource uiTextBrush}"
				Margin="4 4 0 4"
				Padding="10 3"
				Click="btnOption_Click">设置</Button>
            <Button
				Name="btnSyn"
				Grid.Column="3"
				Background="#FFFFFFFF"
				BorderBrush="#66FFFFFF"
				Foreground="{StaticResource uiTextBrush}"
				Margin="4 4 8 4"
				Padding="10 3"
                Click="btnHide_Click">隐藏</Button>
        </Grid>
        <Grid
			Name="grdWaiting"
            Grid.Row="1"
			Background="{StaticResource uiSurfaceBrush}"
			Visibility="Collapsed">
            <ProgressBar
				Height="3"
				IsIndeterminate="True" />
        </Grid>
        <TabControl
			Name="tabControl"
			Grid.Row="2"
			Background="{StaticResource uiSurfaceBrush}"
			BorderBrush="{StaticResource uiBorderBrush}" />
		<Rectangle
			Grid.RowSpan="3"
			HorizontalAlignment="Right"
			VerticalAlignment="Stretch"
			Width="5"
			Cursor="SizeWE"
			Fill="#00FFFFFF"
			MouseLeftButtonDown="rectWiden_MouseLeftButtonDown"
			MouseLeftButtonUp="rectWiden_MouseLeftButtonUp"
			MouseMove="rectWiden_MouseMove" />
		<Rectangle
			Grid.Row="2"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Bottom"
			Height="5"
			Cursor="SizeNS"
			Fill="#00FFFFFF" 
            MouseLeftButtonDown="rectHighden_MouseLeftButtonDown"
			MouseLeftButtonUp="rectHighden_MouseLeftButtonUp"
			MouseMove="rectHighden_MouseMove" />
		<Rectangle
			Grid.Row="2"
			HorizontalAlignment="Right"
			VerticalAlignment="Bottom"
			Height="5"
			Width="5"
			Cursor="SizeNWSE"
			Fill="#00FFFFFF"
            MouseLeftButtonDown="rectCorner_MouseLeftButtonDown"
			MouseLeftButtonUp="rectCorner_MouseLeftButtonUp"
			MouseMove="rectCorner_MouseMove" />
	</Grid>
</UserControl>
