<UserControl
    x:Class="Bot.AssistWindow.Widget.RightPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    mc:Ignorable="d"
    MinWidth="365"
    Background="{StaticResource uiSurfaceBrush}"
    FontFamily="{StaticResource uiFontFamily}">
    <UserControl.Resources>
        <Style x:Key="tabRightPanel" TargetType="{x:Type TabItem}">
            <Setter Property="Width" Value="0" />
            <Setter Property="Height" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TabItem}">
                        <Border Width="0" Height="0" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuietPanelButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="40" />
            <Setter Property="Padding" Value="8 0" />
            <Setter Property="Margin" Value="4 0 0 0" />
            <Setter Property="Foreground" Value="{StaticResource uiMutedTextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border
                            x:Name="ButtonChrome"
                            Background="{TemplateBinding Background}"
                            CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#10000000" />
                                <Setter Property="Foreground" Value="{StaticResource uiTextBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonChrome" Property="Background" Value="#18000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="{StaticResource uiSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource uiSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image x:Name="iconYellow" />
            <Label
                x:Name="lblSeller"
                Visibility="Collapsed" />
            <Button
                x:Name="btnOption"
                Visibility="Collapsed"
                Click="btnOption_Click" />
            <Button
                x:Name="btnSyn"
                Grid.Column="1"
                Style="{StaticResource QuietPanelButtonStyle}"
                ToolTip="隐藏右侧工作台"
                Click="btnHide_Click">隐藏</Button>
        </Grid>

        <Grid
            x:Name="grdWaiting"
            Grid.Row="1"
            Height="3"
            Visibility="Collapsed">
            <ProgressBar IsIndeterminate="True" />
        </Grid>

        <TabControl
            x:Name="tabControl"
            Grid.Row="2"
            Padding="0"
            Margin="0"
            Background="{StaticResource uiSurfaceBrush}"
            BorderThickness="0" />

        <Rectangle
            Width="5"
            HorizontalAlignment="Left"
            Fill="Transparent"
            Cursor="SizeWE"
            MouseLeftButtonDown="rectWiden_MouseLeftButtonDown"
            MouseLeftButtonUp="rectWiden_MouseLeftButtonUp"
            MouseMove="rectWiden_MouseMove" />
        <Rectangle
            Height="5"
            VerticalAlignment="Bottom"
            Fill="Transparent"
            Cursor="SizeNS"
            MouseLeftButtonDown="rectHighden_MouseLeftButtonDown"
            MouseLeftButtonUp="rectHighden_MouseLeftButtonUp"
            MouseMove="rectHighden_MouseMove" />
        <Rectangle
            Width="12"
            Height="12"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Fill="Transparent"
            Cursor="SizeNESW"
            MouseLeftButtonDown="rectCorner_MouseLeftButtonDown"
            MouseLeftButtonUp="rectCorner_MouseLeftButtonUp"
            MouseMove="rectCorner_MouseMove" />
    </Grid>
</UserControl>
