<UserControl
    x:Class="Bot.Options.CtlRobotOptions"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
    <Border Background="#FFF7FAFF" Padding="18">
        <StackPanel>
            <TextBlock
                Text="基础设置"
                FontSize="18"
                FontWeight="SemiBold"
                Foreground="#1F2937"
                Margin="0 0 0 14" />

            <TextBlock
                Text="千牛安装目录"
                Foreground="#374151"
                Margin="0 0 0 6" />
            <TextBox
                x:Name="txtQianNiuInstallPath"
                Height="28"
                Padding="6 3"
                Width="460"
                HorizontalAlignment="Left" />
            <TextBlock
                Text="示例：D:\AliWorkbench 或 C:\Program Files\AliWorkbench。程序会在该目录下查找 Resources\newWebui\webui.zip。"
                TextWrapping="Wrap"
                Foreground="#6B7280"
                Margin="0 8 0 0"
                Width="500" />

            <TextBlock
                Text="如果不填写，程序会自动从注册表和正在运行的千牛进程中扫描安装目录。"
                TextWrapping="Wrap"
                Foreground="#6B7280"
                Margin="0 6 0 0"
                Width="500" />

            <TextBlock
                Text="钉钉提交人账号"
                Foreground="#374151"
                Margin="0 18 0 6" />
            <TextBox
                x:Name="txtDingTalkSubmitterAccount"
                Height="28"
                Padding="6 3"
                Width="460"
                HorizontalAlignment="Left" />
            <TextBlock
                Text="填写手机号或钉钉 userid。提交智能工单时将作为钉钉 AI 表格的操作人。"
                TextWrapping="Wrap"
                Foreground="#6B7280"
                Margin="0 8 0 0"
                Width="500" />
        </StackPanel>
    </Border>
</UserControl>
