<local:EtWindow x:Class="Bot.Common.Windows.WndTicketForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Bot.Common.Windows"
    Title="智能工单" Width="520" Height="650" WindowStartupLocation="CenterScreen">
    <local:EtWindow.Resources>
        <Style x:Key="TicketSubmitButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="{StaticResource uiAccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="root" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="root" Property="Background" Value="#1F5FE5" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="root" Property="Background" Value="#1749B3" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </local:EtWindow.Resources>
    <Grid>
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 14 0 0">
            <Button Content="取消" Width="76" Margin="0 0 8 0" Click="btnCancel_Click" />
            <Button Content="提交" Width="76" IsDefault="True" Style="{StaticResource TicketSubmitButtonStyle}" Click="btnConfirm_Click" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="txtContext" Margin="0 0 0 14" Foreground="{StaticResource uiSubtleTextBrush}" TextWrapping="Wrap" />
                <TextBlock Text="电话/ID/订单号" />
                <TextBox x:Name="txtCustomerIdentity" Margin="0 4 0 10" />
                <TextBlock Text="店铺" />
                <ComboBox x:Name="cmbShop" Margin="0 4 0 10" />
                <TextBlock Text="问题描述 / 用户需求" />
                <TextBox x:Name="txtDescription" Margin="0 4 0 10" Height="78" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
                <TextBlock Text="附件" />
                <StackPanel Margin="0 4 0 10">
                    <Button HorizontalAlignment="Left" MinWidth="96" Content="添加附件" Click="btnSelectFile_Click" />
                    <WrapPanel x:Name="pnlAttachments" Margin="0 8 0 0" />
                    <TextBlock Text="支持一次选择多个文件；点击图片缩略图可预览。" Margin="0 4 0 0" Foreground="{StaticResource uiSubtleTextBrush}" FontSize="11" />
                </StackPanel>
                <StackPanel x:Name="pnlInvoice">
                    <TextBlock Text="邮箱" /><TextBox x:Name="txtEmail" Margin="0 4 0 10" />
                    <TextBlock Text="是否引导后台自助开票" /><ComboBox x:Name="cmbGuideSelfInvoice" Margin="0 4 0 10" />
                </StackPanel>
                <StackPanel x:Name="pnlTech">
                    <TextBlock Text="机型" /><ComboBox x:Name="cmbDeviceModel" Margin="0 4 0 10" />
                    <TextBlock Text="电话 / 微信号 / 远程号" /><TextBox x:Name="txtContactChannel" Margin="0 4 0 10" />
                    <TextBlock Text="远程软件" /><ComboBox x:Name="cmbRemoteSoftware" Margin="0 4 0 10" />
                    <TextBlock Text="是否可评价" /><ComboBox x:Name="cmbCanRate" Margin="0 4 0 10" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
    <Border x:Name="pnlLoading" Visibility="Collapsed" Background="#A8FFFFFF">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressBar Width="180" Height="5" IsIndeterminate="True" />
            <TextBlock x:Name="txtLoading" Margin="0 10 0 0" Text="正在加载下拉选项…" HorizontalAlignment="Center" />
        </StackPanel>
    </Border>
    </Grid>
</local:EtWindow>
